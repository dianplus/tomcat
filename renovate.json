{
  "extends": [
    "config:recommended"
  ],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^9/Dockerfile\\.renovate$/"
      ],
      "matchStrings": [
        "^FROM\\s+(?<depName>tomcat):(?<currentValue>9\\.[0-9]+\\.[0-9]+)\\s*$"
      ],
      "datasourceTemplate": "docker",
      "versioningTemplate": "docker"
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^10/Dockerfile\\.renovate$/"
      ],
      "matchStrings": [
        "^FROM\\s+(?<depName>tomcat):(?<currentValue>10\\.[0-9]+\\.[0-9]+)\\s*$"
      ],
      "datasourceTemplate": "docker",
      "versioningTemplate": "docker"
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^11/Dockerfile\\.renovate$/"
      ],
      "matchStrings": [
        "^FROM\\s+(?<depName>tomcat):(?<currentValue>11\\.[0-9]+\\.[0-9]+)\\s*$"
      ],
      "datasourceTemplate": "docker",
      "versioningTemplate": "docker"
    }
  ],
  "packageRules": [
    {
      "matchDatasources": [
        "docker"
      ],
      "matchPackageNames": [
        "tomcat"
      ],
      "matchFileNames": [
        "9/Dockerfile.renovate"
      ],
      "allowedVersions": "/^9\\./"
    },
    {
      "matchDatasources": [
        "docker"
      ],
      "matchPackageNames": [
        "tomcat"
      ],
      "matchFileNames": [
        "10/Dockerfile.renovate"
      ],
      "allowedVersions": "/^10\\./"
    },
    {
      "matchDatasources": [
        "docker"
      ],
      "matchPackageNames": [
        "tomcat"
      ],
      "matchFileNames": [
        "11/Dockerfile.renovate"
      ],
      "allowedVersions": "/^11\\./"
    },
    {
      "description": "Auto-merge upstream base image tag bumps",
      "matchDatasources": [
        "docker"
      ],
      "matchPackageNames": [
        "tomcat"
      ],
      "matchFileNames": [
        "9/Dockerfile.renovate",
        "10/Dockerfile.renovate",
        "11/Dockerfile.renovate"
      ],
      "matchUpdateTypes": [
        "patch",
        "minor"
      ],
      "automerge": true,
      "automergeType": "pr",
      "automergeStrategy": "merge-commit",
      "platformAutomerge": false,
      "ignoreTests": true
    }
  ],
  "ignorePaths": [
    "9/**/Dockerfile-*",
    "9/**/Dockerfile",
    "10/**/Dockerfile-*",
    "10/**/Dockerfile",
    "11/**/Dockerfile-*",
    "11/**/Dockerfile"
  ]
}
